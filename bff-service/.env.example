CORE_SERVICE_BASE_URL=http://localhost:8080
TENANT_HEADER=X-Tenant-Id
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://aidevframework:aidevframework@localhost:5432/aidevframework_bff
# universal_ai_agent_orchestrator 연동 (docs/06-ai-agent-integration.md Phase B).
# Docker Compose로 이 서비스를 띄운다면 host.docker.internal을 쓴다(오케스트레이터는 별도
# docker-compose 프로젝트라 컨테이너 DNS로는 안 닿는다). API 키는 절대 커밋하지 말 것.
ORCHESTRATOR_BASE_URL=http://host.docker.internal:8000
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_WORKSPACE_ID=default
ORCHESTRATOR_JOB_TEMPLATE_ID=code-build-job
# git 저장 커넥터 (docs/06-ai-agent-integration.md Phase C). 기본 비활성 — 실제로 GitHub에
# 브랜치·PR을 만들기 시작하므로 켜기 전에 GITHUB_TOKEN 권한 범위를 반드시 확인할 것.
# repo 콘텐츠 쓰기 + PR 생성 권한만 있는 fine-grained PAT 권장(이 저장소 하나로 한정).
GIT_CONNECTOR_ENABLED=false
GITHUB_TOKEN=
GITHUB_OWNER_REPO=yongheejung/ai_dev_framework
GIT_CONNECTOR_BASE_BRANCH=main
GIT_CONNECTOR_PATH_PREFIX=bff-service/
